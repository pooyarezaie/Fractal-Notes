---
layout: none
sitemap: false
permalink: /feed.xml
---
{%- assign notes = "" | split: "" -%}
{%- for group in site.data.site_index -%}
  {%- for item in group.items -%}
    {%- assign target = "/" | append: item.path | append: ".html" -%}
    {%- for p in site.pages -%}
      {%- if p.url == target -%}
        {%- assign notes = notes | push: p -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endfor -%}
{%- endfor -%}
{%- assign notes = notes | sort: "date" | reverse -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="fa">
  <title>{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <id>{{ site.url }}/</id>
  <link href="{{ site.url }}/" />
  <link href="{{ site.url }}/feed.xml" rel="self" type="application/atom+xml" />
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <author>
    <name>{{ site.author.name | xml_escape }}</name>
    <uri>{{ site.url }}/</uri>
  </author>
  {%- for note in notes %}
  <entry>
    <title>{{ note.title | xml_escape }}</title>
    <id>{{ site.url }}{{ note.url }}</id>
    <link href="{{ site.url }}{{ note.url }}" />
    <published>{{ note.date | date_to_xmlschema }}</published>
    <updated>{{ note.last_modified_at | default: note.date | date_to_xmlschema }}</updated>
    <summary>{{ note.description | xml_escape }}</summary>
  </entry>
  {%- endfor %}
</feed>
